<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration Portal</title>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand" href="#home">
                Student Portal
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#home">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#register">
                            Register
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">
                            About
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- Hero Section -->
    <section id="home" class="hero">

        <div class="hero-content">

            <p class="tagline">
                WELCOME TO
            </p>

            <h1>
                Student Registration Portal
            </h1>

            <p>
                A simple and responsive platform for student registration.
            </p>

            <a href="#register" class="hero-button">
                Register Now
            </a>

        </div>

    </section>


    <!-- Registration Section -->
    <section id="register" class="registration-section">

        <div class="container">

            <div class="section-heading">

                <p class="tagline">
                    GET STARTED
                </p>

                <h2>
                    Student Registration
                </h2>

                <p>
                    Enter your details below to register.
                </p>

            </div>


            <div class="row justify-content-center">

                <div class="col-12 col-md-10 col-lg-8">

                    <div class="form-container card border-0 shadow">

                        <form class="card-body">

                            <!-- Name -->
                            <div class="mb-3">

                                <label for="name" class="form-label">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="name"
                                    name="name"
                                    placeholder="Enter your full name"
                                >

                            </div>


                            <!-- Email -->
                            <div class="mb-3">

                                <label for="email" class="form-label">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    class="form-control"
                                    id="email"
                                    name="email"
                                    placeholder="Enter your email"
                                >

                            </div>


                            <!-- Age + Course -->
                            <div class="row">

                                <div class="col-12 col-md-6 mb-3">

                                    <label for="age" class="form-label">
                                        Age
                                    </label>

                                    <input
                                        type="number"
                                        class="form-control"
                                        id="age"
                                        name="age"
                                        placeholder="Enter your age"
                                    >

                                </div>


                                <div class="col-12 col-md-6 mb-3">

                                    <label for="course" class="form-label">
                                        Course
                                    </label>

                                    <select
                                        class="form-select"
                                        id="course"
                                        name="course"
                                    >

                                        <option value="">
                                            Select Course
                                        </option>

                                        <option value="CSE">
                                            Computer Science
                                        </option>

                                        <option value="ISE">
                                            Information Science
                                        </option>

                                        <option value="ECE">
                                            Electronics
                                        </option>

                                        <option value="AIML">
                                            AI & ML
                                        </option>

                                    </select>

                                </div>

                            </div>


                            <!-- Phone -->
                            <div class="mb-3">

                                <label for="phone" class="form-label">
                                    Phone Number
                                </label>

                                <input
                                    type="tel"
                                    class="form-control"
                                    id="phone"
                                    name="phone"
                                    placeholder="Enter 10-digit phone number"
                                >

                            </div>


                            <!-- Submit Button -->
                            <button
                                type="submit"
                                class="btn btn-primary w-100 submit-button"
                            >
                                Register Student
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- About Section -->
    <section id="about" class="about-section">

        <div class="about-content">

            <p class="tagline">
                ABOUT THE PROJECT
            </p>

            <h2>
                Built with Modern Web Technologies
            </h2>

            <p>
                This project demonstrates responsive web design,
                advanced CSS styling and interactive web development
                using HTML, CSS, JavaScript, Node.js and Express.
            </p>

        </div>

    </section>


    <!-- Footer -->
    <footer>

        <p>
            © 2026 Student Registration Portal
        </p>

        <p>
            Cognifyz Full Stack Development Internship
        </p>

    </footer>


    <!-- Custom JavaScript -->
    <script src="/js/script.js"></script>

    <!-- Bootstrap JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>